{
  "name": "asoul-helper",
  "displayName": "A-SOUL小助手-动态与直播提醒",
  "description": "在 VS Code 中接收自定义 B 站用户的动态和直播提醒。",
  "version": "0.2.1",
  "publisher": "P40-traveler",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/P40-traveler/asoul-helper.git"
  },
  "homepage": "https://github.com/P40-traveler/asoul-helper#readme",
  "bugs": {
    "url": "https://github.com/P40-traveler/asoul-helper/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "asoul",
    "bilibili",
    "notification",
    "直播",
    "动态"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "asoulNotifier.openMemberFile",
        "title": "A-SOUL 提醒：打开成员配置"
      },
      {
        "command": "asoulNotifier.checkNow",
        "title": "A-SOUL 提醒：立即检查"
      },
      {
        "command": "asoulNotifier.showLog",
        "title": "A-SOUL 提醒：查看运行日志"
      },
      {
        "command": "asoulNotifier.showBreakReminder",
        "title": "A-SOUL 提醒：预览休息提醒"
      }
    ],
    "configuration": {
      "title": "A-SOUL小助手-动态与直播提醒",
      "properties": {
        "asoulNotifier.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用动态和直播轮询。"
        },
        "asoulNotifier.pollIntervalMinutes": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 60,
          "description": "轮询间隔（分钟）。间隔过短可能触发 B 站风控。"
        },
        "asoulNotifier.breakReminder.enabled": {
          "type": "boolean",
          "default": true,
          "description": "连续编码达到设定时长后显示休息提醒。"
        },
        "asoulNotifier.breakReminder.intervalMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 480,
          "description": "触发休息提醒所需的连续编码时长（分钟）。"
        },
        "asoulNotifier.breakReminder.idleResetMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "没有编辑活动达到该时长后，重新计算连续编码时间（分钟）。"
        },
        "asoulNotifier.breakReminder.popupStyle": {
          "type": "string",
          "default": "notification",
          "enum": ["notification", "modal"],
          "enumDescriptions": ["右下角消息通知", "需要手动关闭的居中弹窗"],
          "description": "休息提醒的展示方式。"
        },
        "asoulNotifier.breakReminder.members": {
          "type": "array",
          "default": ["嘉然", "乃琳", "贝拉"],
          "items": {
            "type": "string",
            "enum": ["嘉然", "乃琳", "贝拉"]
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "随机参与休息提醒的成员。"
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
